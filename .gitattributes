# Normalise line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Binary assets git should never try to diff or convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary

# Generated - collapse in diffs and reviews.
package-lock.json linguist-generated=true -diff
