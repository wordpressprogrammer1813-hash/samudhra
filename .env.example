# =============================================================
# Samudra - environment variables
# Copy this file to .env.local (web) / .env (api) or keep one
# root .env and let both apps read it. NEVER commit real keys.
# =============================================================

# ---------- Supabase (project settings -> API) ----------
# Safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only - full DB access, bypasses RLS. Never expose to the client.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- API (apps/api) ----------
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# ---------- First superadmin ----------
# Email that gets promoted to superadmin by supabase/seed.sql
SUPERADMIN_EMAIL=you@example.com
