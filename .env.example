# =============================================================
# Samudra - environment variables
# Copy to .env (API) and apps/web/.env.local (web):
#   node scripts/setup-env.mjs
# Never commit the real files.
# =============================================================

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project (public values — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never expose to the browser.
# SUPABASE_URL is the same project URL as above, read server-side.
SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
# Signs the superadmin session cookie. Any long random string; rotate to log
# every admin session out at once.
SESSION_SECRET=

# ---------- API (apps/api) ----------
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
